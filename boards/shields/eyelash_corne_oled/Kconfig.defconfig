if SHIELD_EYELASH_CORNE_OLED || SHIELD_EYELASH_CORNE_OLED32

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

# Only takes effect with the built-in status screen; ignored when a custom
# screen replaces it.
config ZMK_WIDGET_BATTERY_STATUS_SHOW_PERCENTAGE
    default y

# Our own status screen, authored for this 128x64 panel in portrait. Selecting
# ZMK_DISPLAY_STATUS_SCREEN_CUSTOM turns it on. Do not combine with another
# shield that also provides zmk_display_status_screen(), such as nice_oled.
config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    imply EYELASH_CORNE_OLED_STATUS_SCREEN

config EYELASH_CORNE_OLED_STATUS_SCREEN
    bool "Eyelash Corne OLED status screen"
    select LV_FONT_UNSCII_16
    select LV_USE_CANVAS
    select LV_USE_LABEL
    select LV_USE_IMG

# ZMK only defaults this for the built-in screen; a custom screen needs it too
# or LVGL has no heap to draw the labels with.
config LV_Z_MEM_POOL_SIZE
    default 4096 if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

endif # ZMK_DISPLAY

if SSD1306

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # SSD1306

endif # SHIELD_EYELASH_CORNE_OLED || SHIELD_EYELASH_CORNE_OLED32
